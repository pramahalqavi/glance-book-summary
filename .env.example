# Firebase Client Configuration (Optional)
# Leave blank to run in local-first mode with built-in sample book summaries.
# Once filled, Glance connects to Cloud Firestore with IndexedDB offline persistence.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (for `npm run seed` only — never prefix with VITE_)
# Path to your downloaded service account JSON key file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
